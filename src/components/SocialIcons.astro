---
/**
 * Starlight's social icons, with a way back to the main site in front.
 *
 * Without this the tutorials site is a dead end: the site title links to
 * this site's own root, and nothing anywhere pointed at konjamcoding.me.
 * Someone arriving on a tutorial from a search result had no way to find
 * out what the rest of the site is.
 *
 * This slot is the right place for it: Starlight renders it in the header
 * on desktop and inside the opened menu on phones, so one link covers
 * both without a second entry in the sidebar.
 */
import Default from "@astrojs/starlight/components/SocialIcons.astro";
import { SITE } from "../lib/site.js";
---

<a class="back-to-main" href={SITE.mainSite}>
  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true" focusable="false">
    <path
      d="M19 12H5M11 18l-6-6 6-6"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span>konjamcoding.me</span>
</a>

<Default><slot /></Default>

<style>
  .back-to-main {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.1rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .back-to-main:hover {
    color: var(--ink);
  }

  .back-to-main svg {
    flex: none;
  }

  /* The header gets crowded between the search box and the theme select
     before it collapses into the menu, so drop to the arrow alone first
     rather than letting it wrap or push the icons off. */
  @media (max-width: 72rem) {
    .back-to-main span {
      display: none;
    }
  }

  /* Inside the opened menu on a phone there is room again, and a bare
     arrow there would mean nothing. */
  @media (max-width: 50rem) {
    .back-to-main span {
      display: inline;
    }
  }
</style>
